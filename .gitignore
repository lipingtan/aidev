# ========================================
# AI 游戏开发工作台
# ========================================

# ----------------------------------------
# 保留 .kiro 目录（工作流规范和配置）
# ----------------------------------------
!.kiro/
!.kiro/**
.kiro/**/*.pyc
.kiro/**/__pycache__/

# ----------------------------------------
# IDE 和编辑器
# ----------------------------------------
.idea/
.vscode/
.cursor/
*.swp
*.swo
*~

# ----------------------------------------
# 操作系统
# ----------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------------------
# 日志和临时文件
# ----------------------------------------
*.log
*.tmp
*.temp
*.bak
.tmp/
node_modules/
package-lock.json

# ----------------------------------------
# 大文件（参考图片由 Git LFS 管理或手动排除）
# ----------------------------------------
# 如果参考图片太大，取消下面的注释
# references/**/*.png
# references/**/*.jpg
# references/**/*.mp4

# ----------------------------------------
# 视频文件（生成的视频不纳入版本控制）
# ----------------------------------------
output_video/

output/.tmp/
# ========================================
# 工程代码通用规则（projects/ 下所有解决方案）
# ========================================

# ----------------------------------------
# Godot 编辑器缓存
# ----------------------------------------
projects/**/.godot/

# ----------------------------------------
# Go 后端
# ----------------------------------------
projects/**/backend/vendor/
projects/**/backend/temp/
projects/**/backend/static/uploadfile/
projects/**/backend/*.exe
projects/**/backend/web/dist/
projects/**/backend/go.sum
projects/**/backend/config/settings.yml
projects/**/backend/config/settings.local.yml
projects/**/backend/config/settings.dev.yml
projects/**/backend/config/settings.dev.*.yml
projects/**/backend/config/settings.deva.yml
projects/**/backend/config/settings.b.dev.yml
projects/**/backend/cmd/migrate/migration/version-local/*
!projects/**/backend/cmd/migrate/migration/version-local/doc.go

# ----------------------------------------
# 前端
# ----------------------------------------
projects/**/frontend/node_modules/
projects/**/frontend/dist/
projects/**/frontend/npm-debug.log*
projects/**/frontend/yarn-debug.log*
projects/**/frontend/yarn-error.log*
projects/**/frontend/tests/**/coverage/
projects/**/frontend/package-lock.json
projects/**/frontend/yarn.lock
projects/**/frontend/pnpm-lock.yaml

# ----------------------------------------
# 构建产物
# ----------------------------------------
projects/**/dist/

# ----------------------------------------
# 可执行文件
# ----------------------------------------
*.exe

# ----------------------------------------
# DLC 大文件
# ----------------------------------------
projects/**/dlc_files/*.pck
projects/**/exported/

# ----------------------------------------
# 日志
# ----------------------------------------
projects/**/logs/

projects/**/bak/