{
  "projectId": "your-api-project-id",
  "environments": {
    "dev": {
      "id": "env-dev-id",
      "name": "开发环境",
      "baseUrl": "http://localhost:80",
      "timeout": 5000,
      "variables": {
        "API_KEY": "dev-key-123"
      }
    },
    "test": {
      "id": "env-test-id",
      "name": "测试环境",
      "baseUrl": "https://api.test.example.com",
      "timeout": 10000,
      "variables": {
        "API_KEY": "test-key-456"
      }
    },
    "staging": {
      "id": "env-staging-id",
      "name": "预发布环境",
      "baseUrl": "https://api.staging.example.com",
      "timeout": 10000,
      "variables": {
        "API_KEY": "staging-key-789"
      }
    },
    "prod": {
      "id": "env-prod-id",
      "name": "生产环境",
      "baseUrl": "https://api.example.com",
      "timeout": 10000,
      "variables": {
        "API_KEY": "prod-key-000"
      }
    }
  },
  "suites": {
    "smoke": {
      "id": "suite-smoke-id",
      "name": "冒烟测试",
      "description": "核心功能冒烟测试",
      "tags": ["smoke", "critical"],
      "testFiles": [
        "tests/user-auth.json",
        "tests/health-check.json"
      ]
    },
    "regression": {
      "id": "suite-regression-id",
      "name": "回归测试",
      "description": "完整回归测试套件",
      "tags": ["regression", "full"],
      "testFiles": [
        "tests/user-auth.json",
        "tests/user-crud.json",
        "tests/order-processing.json",
        "tests/payment-api.json"
      ]
    },
    "sanity": {
      "id": "suite-sanity-id",
      "name": "完整性测试",
      "description": "发布前完整性验证",
      "tags": ["sanity", "release"],
      "testFiles": [
        "tests/health-check.json",
        "tests/user-auth.json",
        "tests/order-processing.json"
      ]
    }
  },
  "report": {
    "formats": ["html", "json", "junit"],
    "outputDir": "./test-reports",
    "options": {
      "includeRequestBody": true,
      "includeResponseBody": true,
      "includeHeaders": false,
      "maxBodySize": 1024,
      "verbose": true
    }
  },
  "notifications": {
    "onFailure": {
      "email": ["qa-team@example.com"],
      "slack": "#qa-notifications",
      "webhook": "https://your-webhook-url.com/failure"
    },
    "onSuccess": {
      "slack": "#qa-notifications",
      "webhook": "https://your-webhook-url.com/success"
    }
  }
}
