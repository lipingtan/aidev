		Name:        "{{.Name}}",
		Version:     "0.1.0",
		Description: "{{.Name}} 插件",
		RoutePrefix: "{{.Name}}",
		Menus: []proto.MenuItem{
			{Title: "{{.NamePascal}}", Icon: "ep/box", Path: "/plugin/{{.Name}}", Sort: 1},
