	return nil
}

func (p *{{.NamePascal}}Plugin) CallPlugin(ctx context.Context, req *proto.CallPluginRequest) (*proto.CallPluginResponse, error) {
	return &proto.CallPluginResponse{Payload: []byte(`{}`)}, nil
