; 分类页（CR-4）：HSplitContainer 布局，左侧分类栏 + 右侧筛选 chips + 2 列网格
[gd_scene load_steps=3 format=3 uid="uid://category_page"]

[ext_resource type="Script" path="res://shell/pages/category.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://shell/components/game_card.tscn" id="2_game_card"]

[node name="CategoryPage" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
card_scene = ExtResource("2_game_card")

[node name="HSplit" type="HSplitContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="CategoryList" type="VBoxContainer" parent="HSplit"]
custom_minimum_size = Vector2(96, 0)
size_flags_horizontal = 0

[node name="RightPanel" type="VBoxContainer" parent="HSplit"]
size_flags_horizontal = 3

[node name="FilterRow" type="HBoxContainer" parent="HSplit/RightPanel"]
layout_mode = 2

[node name="SortDropdown" type="OptionButton" parent="HSplit/RightPanel"]
layout_mode = 2
visible = false

[node name="GridContainer" type="GridContainer" parent="HSplit/RightPanel"]
layout_mode = 2
size_flags_vertical = 3
columns = 2

[node name="EmptyState" type="VBoxContainer" parent="HSplit/RightPanel"]
layout_mode = 2
visible = false

[node name="EmptyLabel" type="Label" parent="HSplit/RightPanel/EmptyState"]
layout_mode = 2
horizontal_alignment = 1
text = "该筛选下暂无游戏"

[node name="ClearBtn" type="Button" parent="HSplit/RightPanel/EmptyState"]
layout_mode = 2
size_flags_horizontal = 1
text = "清除筛选"
