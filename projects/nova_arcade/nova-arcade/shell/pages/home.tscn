; 首页（CR-5）：ThemeToggle + Banner/继续游戏/为你推荐/热门榜/每日任务五区块
[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://shell/pages/home.gd" id="1"]
[ext_resource type="PackedScene" path="res://shell/components/section_continue.tscn" id="2_section_continue"]
[ext_resource type="PackedScene" path="res://shell/components/game_card.tscn" id="3_card"]
[ext_resource type="PackedScene" path="res://shell/components/section_banner.tscn" id="4_banner"]
[ext_resource type="PackedScene" path="res://shell/components/section_charts.tscn" id="5_charts"]
[ext_resource type="PackedScene" path="res://shell/components/section_daily.tscn" id="6_daily"]

[node name="Home" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
card_scene = ExtResource("3_card")

[node name="ThemeButton" type="Button" parent="."]
layout_mode = 0
offset_left = 624.0
offset_top = 32.0
offset_right = 688.0
offset_bottom = 96.0
pivot_offset = Vector2(32, 32)
theme_override_font_sizes/font_size = 36
text = "🎨"

; 主滚动容器：承载所有内容区块
[node name="ScrollView" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_top = 112.0
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="ScrollView"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 24

; Banner 轮播区块（CR-5，最顶）
[node name="SectionBanner" parent="ScrollView/VBox" instance=ExtResource("4_banner")]
layout_mode = 2

; 继续游戏区块（SectionContinue 组件实例）
[node name="SectionContinue" parent="ScrollView/VBox" instance=ExtResource("2_section_continue")]
layout_mode = 2

; 为你推荐区块
[node name="SectionForYou" type="VBoxContainer" parent="ScrollView/VBox"]
layout_mode = 2
visible = false

[node name="SectionTitle" type="Label" parent="ScrollView/VBox/SectionForYou"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "为你推荐"

[node name="ScrollContainer" type="ScrollContainer" parent="ScrollView/VBox/SectionForYou"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 0

[node name="HBox" type="HBoxContainer" parent="ScrollView/VBox/SectionForYou/ScrollContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

; 热门榜区块（CR-5）
[node name="SectionCharts" parent="ScrollView/VBox" instance=ExtResource("5_charts")]
layout_mode = 2

; 每日任务区块（CR-5）
[node name="SectionDaily" parent="ScrollView/VBox" instance=ExtResource("6_daily")]
layout_mode = 2
