; ReviewEditor 模态弹窗（CR-4 T6）：颜色运行时经 ThemeTokens.color 注入，场景仅结构 + 字号
[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://shell/overlays/review_editor.gd" id="1"]

[node name="ReviewEditor" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Dim" type="ColorRect" parent="."]
