offset_top = -260.0
offset_right = 300.0
offset_bottom = 260.0

[node name="VBox" type="VBoxContainer" parent="Card"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="Card/VBox"]
layout_mode = 2
