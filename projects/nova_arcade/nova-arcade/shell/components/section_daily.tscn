[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://shell/components/section_daily.gd" id="1_script"]

[node name="SectionDaily" type="VBoxContainer"]
layout_mode = 2
script = ExtResource("1_script")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleLabel" type="Label" parent="Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "每日任务"

[node name="ProgressLabel" type="Label" parent="Header"]
layout_mode = 2
size_flags_vertical = 8
text = "0/3"

[node name="TaskList" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="CompletedLabel" type="Label" parent="."]
layout_mode = 2
visible = false
text = "🎉 今日已全部完成"
