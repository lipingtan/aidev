; 青瓷·素笺 Theme（CD §8.1/§8.5）：Panel/Label/Button/LineEdit StyleBoxFlat 样式
; 浅色主题：卡片投影用 StyleBoxFlat shadow 模拟（--sh: 0 2px 10px rgba(90,105,98,.07)）
[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="StyleBoxFlat" id="sb_panel"]
bg_color = Color(1, 1, 1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.902, 0.882, 0.839, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10
shadow_color = Color(0.353, 0.412, 0.384, 0.07)
shadow_size = 10

[sub_resource type="StyleBoxFlat" id="sb_btn"]
bg_color = Color(0.906, 0.941, 0.918, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.29, 0.49, 0.392, 0.4)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="sb_btn_hover"]
bg_color = Color(0.29, 0.49, 0.392, 0.16)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.29, 0.49, 0.392, 0.6)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="sb_btn_pressed"]
bg_color = Color(0.29, 0.49, 0.392, 0.28)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.29, 0.49, 0.392, 0.8)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[sub_resource type="StyleBoxFlat" id="sb_edit"]
bg_color = Color(1, 1, 1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.902, 0.882, 0.839, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[resource]
default_font_size = 24
Label/colors/font_color = Color(0.184, 0.227, 0.208, 1)
Label/colors/font_hover_color = Color(0.184, 0.227, 0.208, 1)
Panel/styles/panel = SubResource("sb_panel")
Button/colors/font_color = Color(0.184, 0.227, 0.208, 1)
Button/colors/font_hover_color = Color(0.29, 0.49, 0.392, 1)
Button/colors/font_pressed_color = Color(0.29, 0.49, 0.392, 1)
Button/styles/normal = SubResource("sb_btn")
Button/styles/hover = SubResource("sb_btn_hover")
Button/styles/pressed = SubResource("sb_btn_pressed")
Button/styles/focus = SubResource("sb_btn_hover")
LineEdit/colors/insert_color = Color(0.184, 0.227, 0.208, 1)
LineEdit/styles/normal = SubResource("sb_edit")
LineEdit/styles/focus = SubResource("sb_edit")
