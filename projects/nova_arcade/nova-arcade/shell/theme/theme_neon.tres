; 霓虹·星穹 Theme（CD §8.1/§8.5）：Panel/Label/Button/LineEdit StyleBoxFlat 样式
; 禁用 hdr_2d/glow，霓虹感由半透明边框/底色分层模拟
[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="StyleBoxFlat" id="sb_panel"]
bg_color = Color(0.039, 0.063, 0.133, 0.72)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.169, 0.91, 1, 0.18)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_left = 16
corner_radius_bottom_right = 16

[sub_resource type="StyleBoxFlat" id="sb_btn"]
bg_color = Color(0.055, 0.086, 0.188, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.169, 0.91, 1, 0.18)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[sub_resource type="StyleBoxFlat" id="sb_btn_hover"]
bg_color = Color(0.169, 0.91, 1, 0.1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.169, 0.91, 1, 0.4)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[sub_resource type="StyleBoxFlat" id="sb_btn_pressed"]
bg_color = Color(0.169, 0.91, 1, 0.2)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.169, 0.91, 1, 0.5)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_left = 12
corner_radius_bottom_right = 12

[sub_resource type="StyleBoxFlat" id="sb_edit"]
bg_color = Color(0.055, 0.086, 0.188, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.169, 0.91, 1, 0.18)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_left = 8
corner_radius_bottom_right = 8

[resource]
default_font_size = 24
Label/colors/font_color = Color(0.812, 0.918, 1, 1)
Label/colors/font_hover_color = Color(0.812, 0.918, 1, 1)
Panel/styles/panel = SubResource("sb_panel")
Button/colors/font_color = Color(0.812, 0.918, 1, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/styles/normal = SubResource("sb_btn")
Button/styles/hover = SubResource("sb_btn_hover")
Button/styles/pressed = SubResource("sb_btn_pressed")
Button/styles/focus = SubResource("sb_btn_hover")
LineEdit/colors/insert_color = Color(0.812, 0.918, 1, 1)
LineEdit/styles/normal = SubResource("sb_edit")
LineEdit/styles/focus = SubResource("sb_edit")
